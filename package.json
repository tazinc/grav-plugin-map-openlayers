{
  "name": "map-openlayers",
  "version": "0.0.1",
  "description": "The **Map OpenLayers** Plugin is for [Grav CMS](http://github.com/getgrav/grav). Embed a map with markers using fontawesome icons or letters/numbers. Uses open source [OpenLayers js library](https://openlayers.org) with data from [OpenStreetMap](https://www.openstreetmap.org). Enhanced map styling can be obtained from  [Thunderforest](https://www.thunderforest.com) or [MapBox](https://www.mapbox.com), but requires an api key (royalty free options are available).",
  "private": true,
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@rollup-extras/plugin-clean": "^2.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "autoprefixer": "^10.6.1",
    "css-loader": "^7.1.4",
    "cssnano": "^9.0.5",
    "minimist": "^1.2.8",
    "npm-run-all2": "^9.0.3",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "rollup": "^4.63.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.0"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "npm-watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ol": "10.10.0"
  },
  "watch": {
    "build": {
      "patterns": [
        "js"
      ],
      "extensions": "ts",
      "quiet": "false"
    }
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "~12"
      },
      {
        "name": "npm",
        "version": "~24"
      }
    ]
  }
}
